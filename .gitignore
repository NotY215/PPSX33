# Visual Studio Community
# ------------------------------------------------------------
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.ncb
ipch/

# ------------------------------------------------------------
# VS Code (we do not use it – ignore completely)
# ------------------------------------------------------------
.vscode/

# ------------------------------------------------------------
# C# / .NET
# ------------------------------------------------------------
**/bin/
**/obj/
*.csproj.user
*.DotSettings.user
project.lock.json
artifacts/

# ------------------------------------------------------------
# Compilers-files – never commit the actual toolchain binaries.
# Only the README stays in git. Users (and the release package)
# put g++.exe, ninja.exe, required MinGW DLLs etc. here so the
# final game.exe can be built without a system-wide C++ install.
# ------------------------------------------------------------
Compilers-files/*
!Compilers-files/README.md

# ------------------------------------------------------------
# CMake generated (outside build/)
# ------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
_deps/

# ------------------------------------------------------------
# Compiled objects / intermediates
# ------------------------------------------------------------
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib
*.exe
*.pdb
*.ilk
*.exp
*.idb
*.ipdb
*.iobj
*.map

# Keep source scripts
!scripts/*.bat
!scripts/*.sh
!scripts/*.py

# ------------------------------------------------------------
# OS / editor junk
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.idea/
*.log

