# ------------------------------------------------------------
# Build / output (we use build/ only; out/ is legacy)
# ------------------------------------------------------------
build/
out/
dist/

# ------------------------------------------------------------
# Visual Studio (Community / Professional)
# ------------------------------------------------------------
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.ncb
ipch/

# ------------------------------------------------------------
# Visual Studio Code
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
!.vscode/launch.json
!.vscode/tasks.json

# ------------------------------------------------------------
# C# / .NET (GUI)
# ------------------------------------------------------------
**/bin/
**/obj/
*.csproj.user
*.DotSettings.user
project.lock.json
artifacts/

# ------------------------------------------------------------
# Compilers-files (never commit the actual toolchain binaries)
# Keep only the README so people know what to put here
# ------------------------------------------------------------
Compilers-files/*
!Compilers-files/README.md

# ------------------------------------------------------------
# CMake (generated files that may appear outside build/)
# ------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
_deps/

# ------------------------------------------------------------
# Compiled objects / intermediates (safety net)
# ------------------------------------------------------------
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib
*.exe
*.pdb
*.ilk
*.exp
*.idb
*.ipdb
*.iobj
*.map

# Keep scripts that are source
!scripts/*.bat
!scripts/*.sh
!scripts/*.py

# ------------------------------------------------------------
# OS / editor junk
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.idea/
*.log

# ------------------------------------------------------------
# Game project folders created by the app (never commit these)
# ------------------------------------------------------------
# They appear next to the exe as <GameName>/{input,codebase,output}
# Ignore common patterns if someone runs from source tree
**/input/EBOOT.elf
**/codebase/
**/output/
