+static int window_is_focused(void) {
+#if defined(_WIN32)
+    HWND fg = GetForegroundWindow();
+    if (!fg) return 0;
+    DWORD pid = 0;
+    GetWindowThreadProcessId(fg, &pid);
+    return pid == GetCurrentProcessId() ? 1 : 0;
+#else
+    return 1;
+#endif
+}
