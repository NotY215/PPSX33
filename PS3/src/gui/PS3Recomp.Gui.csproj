<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 1 UI. Requires the .NET 8 SDK (put the runtime pieces into Compilers-files if shipping them). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PS3Recomp</AssemblyName>
    <RootNamespace>PS3Recomp.Gui</RootNamespace>
  </PropertyGroup>
</Project>
