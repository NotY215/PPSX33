{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare-smoke-elf",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/tests/make_test_elf.py",
        "${workspaceFolder}/build/test.elf"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "CMake: build",
      "type": "cmake",
      "command": "build",
      "targets": ["all"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
